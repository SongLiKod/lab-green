{
  "name": "lab-green",
  "version": "1.0.0",
  "private": true,
  "description": "LabGreen - 纯前端多账号 GitLab 一站式管理工具（Web / Windows Electron / Android WebView）",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:only": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "electron:dev": "electron .",
    "electron:build": "npm run build:only && electron-builder"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.7.7",
    "element-plus": "^2.8.4",
    "markdown-it": "^14.1.0",
    "pinia": "^2.2.4",
    "vant": "^4.9.7",
    "vue": "^3.5.11",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@vitejs/plugin-vue": "^5.1.4",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vue-tsc": "^2.1.6"
  },
  "build": {
    "appId": "com.labgreen.app",
    "productName": "LabGreen",
    "directories": { "output": "release" },
    "files": ["dist/**", "electron/**"],
    "win": { "target": ["nsis", "portable"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
